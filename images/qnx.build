[type=link] /compat/qnx/usr/bin/wc=/compat/qnx/usr/bin/toybox

# QNX utilities, from the SDP.
/compat/qnx/bin/pidin=pidin
/compat/qnx/bin/stty=stty
/compat/qnx/bin/kill=kill
/compat/qnx/bin/slay=slay
/compat/qnx/bin/hostname=hostname
/compat/qnx/bin/on=on
/compat/qnx/bin/waitfor=waitfor
/compat/qnx/usr/bin/getconf=getconf
/compat/qnx/usr/bin/top=top
/compat/qnx/bin/slogger2=slogger2
/compat/qnx/bin/slog2info=slog2info
