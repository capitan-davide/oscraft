[type=link] /compat/qnx/usr/bin/tty=/compat/qnx/usr/bin/toybox
[type=link] /compat/qnx/usr/bin/uniq=/compat/qnx/usr/bin/toybox
[type=link] /compat/qnx/usr/bin/unix2dos=/compat/qnx/usr/bin/toybox
[type=link] /compat/qnx/usr/bin/unlink=/compat/qnx/usr/bin/toybox
[type=link] /compat/qnx/usr/bin/uudecode=/compat/qnx/usr/bin/toybox
