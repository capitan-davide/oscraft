###############################################################################
# The QNX test programs, the oracle the QNX personality is measured
# against, for `make test QNX=1`: appended by the Makefile to
# images/qemu-virt.build (less its console) and images/qnx.build. Built
# with the SDP's GCC against QNX's libc (tests/qnx, the Makefile's
# qnx-tests). The tests are typed into QNX's shell, so this file ends the
# boot script with QNX's serial driver and ksh as the console.
###############################################################################

[+script] .script = {
    qnxhello
    qnx-hello one two
    qnx-sysinfo
    qnx-hello-dyn
    /compat/qnx/bin/ksh -c "echo hello from ksh"
    # QNX's serial driver on the PL011 (0x09000000, GIC SPI 1: vector 33,
    # a 24 MHz clock), then the session on it: QNX's shell is the console.
    /compat/qnx/sbin/devc-serpl011 -b115200 -c24000000 -e -F -u1 0x09000000,33 &
    waitfor /dev/ser1
    reopen /dev/ser1
    [+session] /compat/qnx/bin/ksh &
}

# The minimal program of the QNX personality: Rust, no libc, QNX's
# kernel-call ABI (tests/qnx/qnxhello).
/proc/boot/qnxhello=${OSCRAFT_USER}/qnxhello

# The QNX test programs (tests/qnx, built with the SDP's GCC).
/proc/boot/qnx-hello=${OSCRAFT_QNX_TESTS}/hello-static
/proc/boot/qnx-sysinfo=${OSCRAFT_QNX_TESTS}/sysinfo-static
/proc/boot/qnx-hello-dyn=${OSCRAFT_QNX_TESTS}/hello-dyn
/proc/boot/spawntest=${OSCRAFT_QNX_TESTS}/spawntest
