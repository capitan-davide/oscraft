###############################################################################
# QNX OS 8.0's own kernel on QEMU's virt machine: the reference OsCraft's
# QNX personality is measured against (make qnx-image, make qnx-test,
# tools/qnx/probe.py). procnto and QNX's programs come from the user's SDP
# ($QNX_TARGET, not part of this repository); the startup is OsCraft's
# (startup/boards/qemu-virt), which boots procnto as QNX's own would. The
# QNX test programs (tests/qnx) are the same as in OsCraft's QNX overlay.
###############################################################################

[image=0x40080000]
[virtual=aarch64le,raw] .boot = {
    startup-qemu-virt -v -u reg
    PATH=/proc/boot:/bin:/usr/bin:/sbin:/usr/sbin
    LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib
    [+keeplinked] procnto-smp-instr -v
}
[+script] .script = {
    display_msg "OsCraft mkifs: QNX 8.0 reference image"
    # A program that fails to start (a text file): reported, and no
    # process left behind (bootfailtest).
    /proc/boot/notaprogram
    # Console on the PL011 (0x09000000, GIC SPI 1: vector 33, 24 MHz).
    devc-serpl011 -b115200 -c24000000 -e -F -u1 0x09000000,33
    waitfor /dev/ser1
    reopen /dev/ser1
    # Pipe manager, needed by ksh for $(...) and pipelines.
    pipe
    waitfor /dev/pipe
    # Pseudo-terminals (sessiontest).
    devc-pty
    SYSNAME=nto
    TERM=qansi
    ksh -c "echo Welcome to QNX $(uname -r) on $(uname -m)!"
    [+session] ksh &
}
[uid=0 gid=0]
[-optional]
[type=link] /bin/sh=/bin/ksh
[type=link] /dev/console=/dev/ser1
[type=link] /tmp=/dev/shmem
[type=link] /usr/tmp=/tmp
/usr/lib/ldqnx-64.so.2=ldqnx-64.so.2
[type=link] /usr/lib/ld-oscraft.so.1=/usr/lib/ldqnx-64.so.2
/lib/libc.so=libc.so
/lib/libgcc_s.so=libgcc_s.so.1
/lib/libsecpol.so=libsecpol.so.1
/lib/libfsnotify.so=libfsnotify.so.1
/lib/libm.so=libm.so.3
/usr/lib/libz.so=libz.so.2
/sbin/devc-serpl011=devc-serpl011
/sbin/pipe=pipe
/bin/ksh=ksh
/sbin/devc-pty=devc-pty
/bin/pidin=pidin
/sbin/shutdown=shutdown
/usr/sbin/tracelogger=tracelogger
/lib/libtracelog.so.1=libtracelog.so.1
/usr/bin/toybox=toybox
[type=link] /bin/ls=/usr/bin/toybox
[type=link] /bin/cat=/usr/bin/toybox
[type=link] /bin/echo=/usr/bin/toybox
[type=link] /bin/uname=/usr/bin/toybox
[type=link] /bin/sleep=/usr/bin/toybox
[type=link] /bin/base64=/usr/bin/toybox
[type=link] /bin/wc=/usr/bin/toybox
[type=link] /bin/head=/usr/bin/toybox
/bin/kpipe=kpipe
/lib/libslog2.so.1=libslog2.so.1
/sbin/mqueue=mqueue
[perms=0755] /proc/boot/notaprogram = {
not a program
}

# The QNX test programs (tests/qnx, make qnx-tests): the same as in
# OsCraft's QNX overlay, so that `make qnx-test` runs the suite's QNX
# tests on procnto.
