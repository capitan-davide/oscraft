# pidin's views through procnto's introspection: timers, interrupts,
# channels (DCMD_PROC_TIMERS, _IRQS, _CHANNELS), run masks
# (DCMD_PROC_THREADCTL), registers (_PROC_DEBUG), thread stacks;
# /proc/self in /proc; /proc as procnto lists it (no "." or "..",
# /proc/config) and procnto's own exefile.
name: pidin-views
needs: qnx
timeout: 30
run: pidin timers | grep -m1 PULSE
run: pidin irqs | grep -m1 =PULSE
run: pidin channels | grep -m1 ReceiveQ
run: pidin rmasks | grep -m1 Runmask
run: pidin regs 2>&1 | grep -m1 -e failed -e X0:
run: pidin -p slogger2 mem | grep -m1 RECEIVE
run: ls /proc | grep -x self
run: echo dots $(ls -a /proc /proc/1 | grep -c -F -x -e . -e ..) config $(ls /proc | grep -c -x config)
run: cat /proc/1/exefile; echo
run: echo qnx: $(cat /proc/self/personality) freebsd: $(/proc/boot/exec-test /bin/sh -c 'read p < /proc/self/personality; echo $p') kernel: $(cat /proc/1/personality)
expect: \d+\s+0\s+0 (REAL|MONO) .* PULSE 0x
expect: =PULSE 0x
expect: ReceiveQ \d
expect: Runmask\s+: 0x
expect: X0:0
expect: RECEIVE\s+\d+K\s+\d+K\s+\d+K/\d+K
expect: ^self$
expect: dots 0 config 1
expect: ^/proc/boot/kernel
expect: ^qnx: qnx freebsd: freebsd kernel: (freebsd|qnx)$
reject: couldn't fill|failed:

