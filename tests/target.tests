# Programs and scripts outside the image filesystem: in /tmp (procnto's
# /dev/shmem). One without an execute bit isn't run (EACCES).
name: exec-tmp
needs: qnx
run: cp /proc/boot/qnx-hello-dyn /tmp/h; /tmp/h a b
expect: argc=3 argv\[0\]=/tmp/h
run: echo '#!/bin/sh' > /tmp/s.sh; echo 'echo script ran $1' >> /tmp/s.sh; chmod +x /tmp/s.sh; /tmp/s.sh arg
expect: ^script ran arg$
run: echo x > /tmp/nx; /tmp/nx; rm /tmp/h /tmp/s.sh /tmp/nx
expect: Permission denied

# Programs and scripts on another server's filesystem (fs-qnx6 on a RAM
# disk), read by procnto as a client.
name: exec-disk
needs: qnx
timeout: 20
run: devb-ram ram capacity=8192 &
run: sleep 2; mkqnx6fs -q /dev/hd0; mount -t qnx6 -o sync=ignore /dev/hd0 /q6
run: cp /proc/boot/qnx-hello /q6/hs; cp /proc/boot/qnx-hello-dyn /q6/hd; /q6/hs one; /q6/hd two
run: echo '#!/bin/sh' > /q6/s.sh; echo 'echo q6 script $1' >> /q6/s.sh; chmod +x /q6/s.sh; /q6/s.sh three
run: umount /q6
expect: argc=2 argv\[0\]=/q6/hs
expect: argc=2 argv\[0\]=/q6/hd
expect: ^q6 script three$

