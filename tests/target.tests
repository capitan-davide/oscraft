run: /proc/boot/netintr-test
run: /proc/boot/net6-test
expect: ^net: bound to 127\.0\.0\.1 port>0:1 len=16$
expect: ^net: connected udp: bind=0 connect=0 send=9 errno=0 recv=9 connected$
expect: ^net: SO_TYPE=1 \(SOCK_STREAM=1\)$
expect: ^net: socketpair=0 sendmsg\(rights\)=1 recvmsg=1 data=x fd received:1 differs:1 read via it=
expect: ^net: unix bind on shmem=0 \(errno 0\)$
expect: ^net: udp datagram \(8\) from port matches:1 len=16$
expect: ^net: sysctlbyname\(net\.inet\.ip\.ttl\)=0 ttl=64$
expect: ^net: ifaddr lo0 127\.0\.0\.1$
expect: ^net: SIOCGIFFLAGS=0 loopback:1 up:1$
expect: ^net: done$
expect: ^netintr: accept=-1 errno=4$
expect: ^netintr: recv=-1 errno=4$
expect: ^netintr: unix=-1 errno=4$
expect: ^netintr: done$
expect: ^net6: udp got six \(3\)$
expect: ^net6: tcp got over tcp \(8\)$
expect: ^net6: unix node$
expect: ^net6: unix in use$
expect: ^net6: unix got named$
expect: ^net6: done$
expect: rc=0
reject: not implemented|panic

# FreeBSD's network tools against netd, which the base image starts.
name: netd-tools
timeout: 40
run: /bin/sleep 2; /sbin/ifconfig lo0; echo ifc=$?
run: /sbin/ifconfig lo0 alias 127.0.0.2/32; echo alias=$?; /sbin/ifconfig lo0 | /usr/bin/grep -c 127.0.0.2
run: /sbin/ping -c 2 127.0.0.1; echo ping=$?
run: /sbin/route -n get 127.0.0.1; echo route=$?
run: /usr/bin/netstat -rn; echo rtab=$?
run: /usr/bin/netstat -an; echo sock=$?
run: /usr/bin/netstat -s -p tcp | /usr/bin/head -3; echo stat=$?
expect: inet 127\.0\.0\.1 netmask 0xff000000
expect: ifc=0
expect: alias=0
expect: ping=0
expect: route=0
expect: rtab=0
expect: sock=0
reject: not implemented|panic

