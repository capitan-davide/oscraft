# Target tests: run by `make test` (tools/test/run-tests.py) against the
# image booted in QEMU. Each block runs shell commands (or a gdb script)
# and checks the output. See tools/test/run-tests.py for the format.

name: qnx-libc
needs: qnx
run: qnx-hello one two
run: qnx-hello-dyn x
expect: ^hello from QNX libc, argc=3 argv\[0\]=qnx-hello$
expect: ^hello from QNX libc, argc=2 argv\[0\]=qnx-hello-dyn$


# A program marked ELFOSABI_FREEBSD starts as a FreeBSD process: its
# stack, auxv and ps_strings are FreeBSD's, x0 is the stack pointer, and
# the thread pointer is left for its libc (tests/native/hello).
name: hello
run: hello one two
expect: hello: argc=3 x0==sp:true sp%16=0 tpidr_el0=0x0$
expect: hello: argv: hello one two$
expect: hello: AT_EXECPATH /proc/boot/hello$
expect: hello: AT_ARGV ok:true$
expect: hello: AT_ENVV ok:true$
expect: hello: AT_PAGESIZES \[4096\]$
expect: hello: ps_strings argv ok:true nargv=3 envp ok:true nenv=[0-9]+$

# A FreeBSD program (clang for aarch64-unknown-freebsd, FreeBSD's crt1
# from source, no libc) over libsys: write() as I/O messages, errno in
# FreeBSD's numbering, _exit() with a status.
name: hello-nolibc
run: hello-test one two; echo rc=$?
expect: ^hello-test: a FreeBSD program on OsCraft, argc=3$
expect: ^hello-test: argv: hello-test$
expect: ^hello-test: argv: two$
expect: ^hello-test: envc=[0-9]+$
expect: ^hello-test: write\(99\) -> EBADF$
expect: ^hello-test: getpid=[0-9]+$
expect: ^rc=7$

# A program with FreeBSD's libc (static, built from FreeBSD's tree with
# OsCraft's libsys inside): stdio, malloc, the environment, errno.
name: libc
run: libc-test one two; echo rc=$?
expect: ^libc-test: hello from FreeBSD's libc on OsCraft, argc=3$
expect: ^libc-test: argv\[2\]=two$
expect: ^libc-test: a string in malloc'ed memory \(28 bytes\)$
expect: ^libc-test: PATH=/proc/boot
expect: ^libc-test: getpid=[0-9]+ getpagesize=4096$
expect: ^libc-test: write\(99\): Bad file descriptor$
expect: ^libc-test: read: line two$
expect: ^libc-test: stat: size=18 mode=666$
expect: ^libc-test: access\(/proc/boot, R_OK\)=0 access\(/nonexistent, F_OK\)=-1 errno=No such file or directory$
expect: ^libc-test: uid=0 gid=0 ppid>0:1$
expect: ^libc-test: monotonic>0:1$
expect: ^libc-test: ncpu=4$
expect: ^libc-test: rename ok, old gone: No such file or directory$
expect: ^libc-test: SIGUSR1 handler: signo=30 code=SI_USER:1 pid ok:1 context ok:1 old handler dfl:1$
expect: ^libc-test: SIGUSR1 blocked:1 SIGINT blocked:0 kill\(self,0\)=0$
expect: ^rc=7$

# The same program dynamically linked: ld-elf.so.1 (FreeBSD's loader,
# with OsCraft's libsys inside) maps libc.so.7 and libsys.so.7.
name: dyn
run: dyn-test one two; echo rc=$?
expect: ^libc-test: hello from FreeBSD's libc on OsCraft, argc=3$
expect: ^libc-test: read: line two$
expect: ^libc-test: ncpu=4$
expect: ^libc-test: SIGUSR1 handler: signo=30 code=SI_USER:1 pid ok:1 context ok:1 old handler dfl:1$
expect: ^libc-test: SIGUSR1 blocked:1 SIGINT blocked:0 kill\(self,0\)=0$
expect: ^rc=7$

# FreeBSD's libthr on OsCraft: threads over the kernel's thr_new, a
# mutex and a condition variable over its futex (_umtx_op in libsys).
name: thr
run: thr-test xrw; echo rc=$?
run: thr-test; echo rc=$?
run: thr-dyn-test; echo rc=$?
expect: ^thr-test: joined thread 3, returned 4$
expect: ^thr-test: counter=80000 \(expected 80000\)$
expect: ^thr-test: consumer saw 3 handshakes, returned 7$
expect: ^thr-test: rwlock: shared=4000 \(expected 4000\) readers at once>1:[01]$
expect: ^rc=0$
expect: ^thr-test: consumer saw 3 handshakes, returned 7\n(.*\n)*.*rc=0\n(.*\n)*.*thr-test: consumer saw 3 handshakes, returned 7$

# A priority-inheriting mutex (FUTEX_WAIT_PI): the holder, at 10, runs at
# the SCHED_FIFO waiter's 16 (rtprio_thread over SchedSet) until it
# unlocks; a SIGCHLD pending while system() blocks it ends no wait.
name: thr-test-pi
needs: qnx
run: thr-test p; echo rc=$?
expect: ^ +\d+ +1 proc/boot/thr-test +16r REPLY .*\n +\d+ +2 proc/boot/thr-test +16f SEM
expect: ^thr-test: waiter getschedparam=0 policy=1 priority=5$
expect: ^thr-test: holder policy=2 priority=0$
expect: ^thr-test: high: lock=0 unlock=0$
expect: ^ +\d+ +1 proc/boot/thr-test +10r REPLY .*\n.*rc=0$

# FreeBSD's own utilities, dynamic, at /bin and /usr/bin, run by FreeBSD's
# sh: files on /dev/shmem, pipes between them, the usual text tools.
name: utils
timeout: 30
run: /bin/ls /bin | /usr/bin/head -2 | /usr/bin/wc -l
expect: ^ *2$
run: sh -c 'export PATH=/bin:/usr/bin; cd /tmp && echo hello world > uf && cat uf && ls uf && wc -w < uf && seq 5 | sort -rn | head -2 | tr "\n" " " && echo && printf "%s-%s\n" a b && cp uf uf2 && mv uf2 uf3 && test -e uf3 && rm uf uf3 && test ! -e uf3 && echo gone; id -u; uname -s; mkdir d1 && rmdir d1 && echo dirs; date +%Y | grep -c "^[0-9]"; echo abc | cut -c2 | tr b B'
expect: ^hello world$
expect: ^uf$
expect: ^ *2$
expect: ^5 4 $
expect: ^a-b$
expect: ^gone$
expect: ^0$
expect: ^OsCraft$
expect: ^dirs$
expect: ^1$
expect: ^B$

# libsys's misc calls: the time of day, sched_yield, getrusage, the alarm
# (setitimer, alarm), POSIX timers (librt over ktimer_*: a signal with
# its value and SI_TIMER, overruns), truncate, fchown, futimens and
# utimensat (UTIME_NOW, UTIME_OMIT), fpathconf, flock, the memory
# no-ops, statfs (shmem's statvfs), nice values, the POSIX sched calls,
# sigaltstack, shm_open, getlogin, groups and the set-id calls (which
# drop root last). /dev/shmem
# refuses links and FIFO nodes (ENOSYS, 78), and none of procnto's files
# answers pathconf (EINVAL, 22, measured: the proctest).

# The native random server (user/random, on the resource-manager
# framework user/resmgr), /dev/random and /dev/urandom:
# reads of any size, two reads differ, a write is taken (mixed into the
# key); and pipelines inside command substitutions, which share a server
# connection ID across two pipes (the pipe manager's copies).
# A SIGCHLD during ksh's close() of a pipe's end, through qnxd: the close
# must finish, or cat inherits the writer and waits for itself.
name: qnxd-signal
needs: qnx
timeout: 60
run: i=0; while [ $i -lt 40 ]; do a=$(echo x | cat); i=$((i+1)); done; echo rounds=$i
expect: ^rounds=40$

# syslog(3) through the ring to the Rust syslogd and its file.
name: native-syslog
timeout: 30
run: syslog-test
run: /usr/bin/logger -p user.notice -t lgtest hello from a shell; /bin/sleep 1; /bin/cat /var/log/messages
expect: ^syslog-test: passed$
expect: lgtest\[\d+\]: hello from a shell$
reject: syslog-test: FAIL

# FAT, served by diskd-md on an image mkfs.fat and mcopy made: from a
# FreeBSD program, then, through qnxd, from QNX's tools.
name: native-fat
timeout: 40
run: fs-test
expect: ^fs-test: passed$
reject: fs-test: FAIL

name: qnx-on-native-fat
needs: qnx
timeout: 20
run: cat /md0/HELLO.TXT
run: ls /md0
run: echo through ksh > /md0/qnx.txt; cat /md0/qnx.txt
run: mkdir /md0/q; ls -d /md0/q; rmdir /md0/q; ls -l /md0/big
run: slay -f diskd-md
expect: ^hello, DISK$
expect: a\\ long\\ name\.text
expect: ^through ksh$
expect: /md0/q
expect: 200000
reject: cannot|No such|not found

# FreeBSD's tools on a memory disk: newfs_msdos, mount, df, umount.
name: native-mount
timeout: 30
run: /proc/boot/diskd-md -s 8 -u 1 &
run: i=0; while [ ! -e /dev/md1 ] && [ $i -lt 50 ]; do /bin/sleep 0.1; i=$((i+1)); done; /sbin/newfs_msdos /dev/md1; echo newfs=$?
run: /bin/mkdir /tmp/mnt; /sbin/mount -t msdosfs /dev/md1 /tmp/mnt; echo mount=$?
run: echo on the new disk > /tmp/mnt/note.txt; /bin/cat /tmp/mnt/note.txt
run: /sbin/mount | /usr/bin/grep md1; /bin/df /tmp/mnt | /usr/bin/tail -1
run: /sbin/umount /tmp/mnt; echo umount=$?; /bin/ls /tmp/mnt; echo rest=$?
run: /sbin/mount -t msdosfs /dev/md1 /tmp/mnt; /bin/cat /tmp/mnt/note.txt; /sbin/umount /tmp/mnt
expect: newfs=0
expect: mount=0
expect: umount=0
expect: /dev/md1 on /tmp/mnt \(msdosfs
expect: ^/dev/md1 +
reject: Operation not|not implemented

# FreeBSD's ps, through libkvm and sysctl(KERN_PROC).
name: native-ps
timeout: 15
run: /bin/sh -c '/bin/ps ax; echo rc=$?'
run: /bin/sh -c '/bin/ps -o pid,ppid,uid,stat,rss,command -p $$'
run: /bin/sh -c '/bin/ps -H -o pid,lwp,cpu,time -p 1; echo threads=$?'
expect: rc=0
expect: \d+ +\S+ +Ss?\+? +\d+:\d+\.\d+ .*syslogd
expect: 1 +- +RL|1 +- +SL
expect: sh
expect: threads=0
expect: ^ *1 +2 +\d+ +\d+:\d+\.\d+
reject: not implemented

# The base console's sh is a session with a terminal: ps with no flags
# finds it, and /dev/tty opens.
name: base-console
run: /bin/ps; echo rc=$?
run: echo through tty > /dev/tty; echo tty=$?
expect: rc=0
expect: ^through tty$
expect: tty=0
expect: \d+ +\S+ +\S+ +\d+:\d+\.\d+ .*sh

# FreeBSD's top, one display in batch mode.
name: native-top
timeout: 20
run: /proc/boot/exec-test /bin/sh -c 'TERM=dumb /usr/bin/top -b -d 1; echo rc=$?'
run: /proc/boot/exec-test /bin/sh -c '/bin/ps; echo rc2=$?'
run: /proc/boot/exec-test /bin/sh -c 'TERM=xterm /usr/bin/top -d 1; echo rc3=$?'
expect: rc=0
expect: rc2=0
expect: rc3=0
expect: \d+ +\S+ +\S+ +\d+:\d+\.\d+ .*ps
expect: processes:
expect: CPU:
expect: Mem:
expect: syslogd
reject: not implemented|failed

# syslog.conf's blocks, include and |program, on another configuration.
name: native-syslog-conf
timeout: 30
run: syslog-test spawn
run: syslog-test conf
expect: ^spawned$
expect: ^syslog-test: passed$
reject: syslog-test: FAIL

# The kernel's messages: dmesg, and through /dev/klog to the log.
name: native-klog
timeout: 20
run: /sbin/dmesg | /usr/bin/grep -c 'bootscript: started'
run: /bin/sleep 2; /bin/cat /var/log/messages* | /usr/bin/grep -c 'kernel: bootscript'
reject: ^0$

# @host: real datagrams, through the socket server.
name: native-syslog-forward
timeout: 20
run: syslog-test forward
expect: ^syslog-test: passed$
reject: syslog-test: FAIL

name: native-random
timeout: 30
run: for i in 1 2 3; do a=$(echo x | cat); echo a=$a; done
run: a=$(head -c 12 /dev/random | od -An -tx1 | tr -d ' \n'); b=$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n'); echo len=$(head -c 1000 /dev/random | wc -c | tr -d ' ') differ=$([ "$a" != "$b" ] && echo yes)
run: echo seed > /dev/random && echo written
expect: ^a=x$
expect: ^len=1000 differ=yes$
expect: ^written$

# OsCraft's pseudo-terminals (user/pty): posix_openpt(), ptsname(), echo
# and canonical input, raw mode, the signal keys, poll(), window size,
# the ends' closes.
name: native-pty
timeout: 30
run: pty-test
expect: ^pty-test: passed$
reject: pty-test: FAIL

# The same manager to a QNX program: every line as on QNX's devc-pty.
name: qnx-pty
needs: qnx
timeout: 30
run: ptytest
expect: ^worker first nonblock 1 errno 0$
expect: ^second 0 errno 16$
expect: ^grantpt 0 unlockpt 0 ptsname /dev/ttyp0$
expect: ^worker 1 isatty 1$
expect: ^mode 620$
expect: ^flags 2d02 5 4b0 8a1b cc 3 127 21 4 1$
expect: ^worker read 3$
expect: ^echo 4$
expect: ^out 3$
expect: ^after worker close: read 0 errno 0$
expect: ^after controller close: read 0 errno 0$
expect: ^write -1 errno 5$

# OsCraft's pipe manager (user/pipe, over the kernel's pipes), the
# system's: pipe-test is kpipetest's checks as a FreeBSD program, and a
# shell pipeline is a client of it too.
name: native-pipe
timeout: 60
run: pipe-test
run: echo a b | cat
expect: ^pipe-test: passed$
reject: pipe-test: FAIL
expect: ^a b$

name: misc
timeout: 30
run: misc-test; echo rc=$?
expect: ^misc: readdir ends:1 rewinddir same:1$
expect: ^misc: rt signal queued:1 values:7,8$
expect: ^misc: SA_RESTART handler ran:1 read:1$
expect: ^misc: gettimeofday within 1s of clock_gettime:1$
expect: ^misc: sched_yield=0$
expect: ^misc: getrusage=0 utime>=0:1$
expect: ^misc: setitimer=0 getitimer left>0:1 alarms=1 alarm\(1\) pending:1$
expect: ^misc: timer_create=0 settime=0 gettime left<=30ms:1 interval=30ms:1 signal=1 value=7 code=SI_TIMER:1 overrun>0:1 delete=0$
expect: ^misc: truncate=0 size=4 fchown\(0,0\)=0 futimens=0 mtime=1000000:1 utimensat\(now,omit\)=0 mtime kept:1 fpathconf\(NAME_MAX\)=-1 \(errno 22\) pathconf\(/proc/boot, NAME_MAX\)=-1 \(errno 22\) flock=0 \(errno 0\) unlock=0$
expect: ^misc: symlink=-1 \(errno 78\)$
expect: ^misc: mkfifo=-1 \(errno 78\)$
expect: ^misc: mincore=0 mlock=0 msync=0$
expect: ^misc: statfs\(/dev/shmem\)=0 \(errno 0\) bsize>0:0 type=shmem getpriority=0 setpriority\(5\)=0 now=5 sched_getscheduler=2 \(OTHER=2\) setscheduler\(FIFO,3\)=2 now=1 prio=3$
expect: ^misc: sigaltstack set=0 get size=8192 shm_open=1 mapped=shm shm_unlink=0 getlogin=root$
expect: ^misc: getgroups=0 first=-1 setgroups=0 now 2: 5 6 setegid\(7\)=0 egid=7 setuid\(100\)=0 uid=100 euid=100 seteuid\(0\) as 100: -1$
expect: ^rc=0$

# The sigwait family over SignalWaitinfo (sigqueue over SignalKill): a
# blocked, queued SIGUSR1 taken with its sender and value; a limit that
# passes is EAGAIN; sigwait returns 0 with the signal.
name: thr-test-sig
run: thr-test s; echo rc=$?
expect: ^thr-test: sigwaitinfo=30 \(SIGUSR1=30\) si_pid matches:1 si_value=42$
expect: ^thr-test: sigtimedwait\(10ms, none\)=-1 errno=35 \(EAGAIN=35\)$
expect: ^thr-test: sigwait=0 sig=31 \(SIGUSR2=31\)$
expect: ^rc=0$

# Thread names (thr_set_name, cut to FreeBSD's 19 bytes) and CPU affinity
# (cpuset_setaffinity: the runmask; another thread's is ENOTSUP, as
# procnto's ThreadCtlExt), shown by pidin.
name: thr-test-names
needs: qnx
run: thr-test n; echo rc=$?
expect: ^thr-test: setaffinity\(cpu 1\)=0$
expect: ^thr-test: getaffinity=0 cpu1 \(1 set\)$
expect: ^thr-test: setaffinity\(other thread\)=45$
expect: ^ +1 main\s*\n\s*Runmask +: 0x00000002$
expect: ^ +2 helper-thread-with-\s*\n\s*Runmask +: 0x0000000f$
expect: ^rc=0$

# FreeBSD's fork, execve and wait4 over the process manager: a child's
# fork reply carries its pid (a FreeBSD process has no thread-local block
# for the kernel to patch); exec is a spawn that replaces the caller.
name: fork
run: fork-test; echo rc=$?
expect: ^fork-test: child pid>parent:1 getppid==parent:1$
expect: ^fork-test: waited pid ok:1 exited:1 status=3$
expect: ^fork-test: exec'ed child exited:1 status=7$
expect: ^fork-test: killed child signaled:1 sig=SIGKILL:1$
expect: ^rc=0$

# FreeBSD's own sh (bin/sh, static) on OsCraft: a pipe to QNX's cat
# (execve of a QNX program from a FreeBSD one), the working directory,
# a loop, an exit status, a script on its standard input.
name: sh
run: sh -c 'echo hello from FreeBSD sh'
run: sh -c 'echo a b | cat'
run: sh -c 'cd /proc/boot && pwd'
run: sh -c 'for i in 1 2 3; do echo n=$i; done; exit 5'; echo rc=$?
run: echo 'echo from a script' | sh
expect: ^hello from FreeBSD sh$
expect: ^a b$
expect: ^/proc/boot$
expect: ^n=1$
expect: ^n=3$
expect: ^rc=5$
expect: ^from a script$

# The console from FreeBSD's libc: the terminal ioctls as QNX's device
# commands on the SDP's serial driver, termios laid out again.
name: tty
run: tty-test; echo rc=$?
expect: ^tty-test: isatty\(0\)=1$
expect: ^tty-test: ICANON=1 ECHO=1 ISIG=1 ICRNL=1 OPOST=1 ONLCR=1 CS8=1$
expect: ^tty-test: VERASE=[1-9][0-9]* VEOF=4 VINTR=3 ospeed=115200$
expect: ^tty-test: raw set: ICANON=0 ECHO=0$
expect: ^tty-test: restored: ICANON=1 ECHO=1$
expect: ^tty-test: winsize ok:1 pgrp>0:1$
expect: ^rc=0$

# FreeBSD's sh as the interactive console shell: started with -i, it
# takes the console over from ksh (libedit reads the terminal), runs the
# lines typed, and gives it back on exit.
name: sh-interactive
run: TERM=xterm PS1='@@# ' sh -i
run: echo interactive $0
run: exit
expect: ^interactive sh$
reject: Cannot read termcap

# FreeBSD's uname and getconf, by path.
name: sysinfo
run: /usr/bin/uname -sr
run: /usr/bin/getconf PAGESIZE
expect: ^OsCraft 0\.1-FREEBSD15$
expect: ^4096$

name: qnx-sysinfo
needs: qnx
run: uname -a
run: getconf PAGESIZE
expect: ^OsCraft localhost 8\.0\.0
expect: ^4096$

name: shell
run: echo a b | cat
run: id
expect: ^a b$
expect: uid=0\(root\)

name: files
run: ls /proc/boot | head -2
run: echo hello > /tmp/t; echo more >> /tmp/t; cat /tmp/t; wc -c /tmp/t; rm /tmp/t; ls /tmp/t
expect: ^hello$
expect: ^more$
expect: ^ *11 /tmp/t$
expect: No such file

name: pidin
needs: qnx
run: pidin -p pidin
run: pidin -p devc-serpl011 mem
run: pidin -p ksh fd
run: pidin info
expect: bin/pidin\s+10r REPLY
expect: libc\.so\.6
expect: /dev/ser1
expect: FreeMem:\d+MB

name: top
needs: qnx
run: top -i 1 -b -z 5
expect: 4 online CPUs; \d+ processes
expect: CPU  3:

name: slay
needs: qnx
run: sleep 30 &
run: slay -f sleep
expect: Terminated\s+sleep 30

name: on
needs: qnx
run: on -p 20 pidin -p pidin
run: on -d sleep 1; echo back
expect: bin/pidin\s+20r
expect: ^back$

name: kill-busy
needs: qnx
run: while :; do :; done &
run: kill %1; sleep 1; jobs
expect: Done \(143\)|Terminated

name: crash
needs: qnx
run: dbgtest crash; echo status=$?
expect: Memory fault
expect: ^status=139$

name: spawn
needs: qnx
run: spawntest
expect: spawntest: passed
reject: FAIL

name: shmem
needs: qnx
run: shmtest
expect: shmtest: passed
reject: FAIL

# A trailing '/' follows a symbolic link (/usr/tmp -> /tmp), as in QNX.
name: trailing-slash
needs: qnx
run: echo x > /tmp/slash; ls -ld /usr/tmp/ | cut -c1; find /usr/tmp/ -name slash; rm /tmp/slash
expect: ^d$
expect: ^/usr/tmp/slash$

name: threads
needs: qnx
run: jointest
expect: jointest: passed
reject: FAIL

name: sync
needs: qnx
run: synctest
expect: synctest: passed
reject: FAIL

name: cancel
needs: qnx
run: canceltest
expect: canceltest: passed
reject: FAIL

name: priority-inheritance
needs: qnx
run: pitest
expect: pitest: passed
reject: FAIL

# Memory given back: processes, threads, channels.
name: leaks
needs: qnx
run: leaktest
expect: leaktest: passed
reject: FAIL
timeout: 120

# POSIX message queues, with QNX's mqueue server (it goes into the background).
name: mqueue
needs: qnx
run: mqueue; waitfor /dev/mqueue 5
run: mqtest
expect: mqtest: passed
reject: FAIL

name: channels
needs: qnx
run: chantest
expect: chantest: passed
reject: FAIL

name: chroot
needs: qnx
run: roottest
expect: roottest: passed
reject: FAIL

name: credentials
needs: qnx
run: credtest
expect: credtest: passed
reject: FAIL

name: special-signals
needs: qnx
run: sigtest
expect: sigtest: passed
reject: FAIL

# Timers as in QNX 8: normal ones on ticks, high-resolution ones on time.
name: timers
needs: qnx
run: hrtest
expect: hrtest: passed
reject: FAIL
timeout: 20

# A thread woken for another CPU runs there at once (an IPI), as in QNX.
name: ipi
needs: qnx
run: ipitest
expect: ipitest: passed
reject: FAIL
timeout: 30

# QNX 8's superlocked memory: backed when mapped, fork() copies at once.
name: superlock
needs: qnx
run: superlocktest
expect: superlocktest: passed
reject: FAIL

name: qnx-fork
needs: qnx
run: forktest
expect: forktest: passed
reject: FAIL

# Kernel tracing with QNX's tracelogger: two seconds of events (not a
# number of buffers: idle CPUs stop ticking, so a quiet system fills them
# slowly, as on QNX; the names of the processes and threads alone are a
# few KB).
name: tracing
needs: qnx
timeout: 20
run: tracelogger -s 2 -f /tmp/t.kev; ls -l /tmp/t.kev; rm /tmp/t.kev
expect: \s[1-9]\d{3,} .*/tmp/t\.kev$

# QNX's slogger2 and slog2info: sshd's buffer, written when the overlay's
# /etc/rc.net started it. (QNX's PL011 driver leaves no lines there,
# unlike the Pi's mini-UART driver this test looked for.)
name: slogger2
needs: qnx
run: slog2info
expect: sshd\.\d+\S*\s+slog\*?\s+\d+\s+.*Server listening on

name: gdb-break
needs: qnx
gdb: tests/gdb/break.gdb
expect: Thread 2 hit Breakpoint 1, add \(a=0, b=0\) at tests/qnx/dbgtest\.c:12
expect: \(JOIN\)
expect: \(STOPPED\)
expect: exited normally

name: gdb-crash
needs: qnx
gdb: tests/gdb/crash.gdb
expect: (Program|Thread 1) received signal SIGSEGV, Segmentation fault
expect: dbgtest\.c:34

# Another session after one that killed its stopped inferior: the kill
# leaves no stale event behind (debugevtest).
name: gdb-again
needs: qnx
gdb: tests/gdb/break.gdb
expect: Thread 2 hit Breakpoint 1, add \(a=0, b=0\) at tests/qnx/dbgtest\.c:12
expect: exited normally

# QNX's block stack (io-blk, cam-disk) and filesystems on a RAM disk:
# devb-ram, then fs-qnx6 and fs-dos, each mounted, written, unmounted and
# mounted again.
name: storage
needs: qnx
timeout: 15
run: devb-ram ram capacity=8192 &
run: sleep 2; mkqnx6fs -q /dev/hd0 && echo made qnx6
run: mount -t qnx6 -o sync=ignore /dev/hd0 /q6; echo qnx6 data > /q6/f; mkdir /q6/d; umount /q6
run: mount -t qnx6 -o sync=ignore /dev/hd0 /q6; cat /q6/f; ls -d /q6/d; umount /q6
run: mkdosfs /dev/hd0
run: mount -t dos /dev/hd0 /fat; echo fat data > /fat/Hello.txt; umount /fat
run: mount -t dos /dev/hd0 /fat; cat /fat/Hello.txt; ls /fat; umount /fat; ls /dev/hd0
expect: ^made qnx6$
expect: ^qnx6 data$
expect: ^/q6/d$
expect: Format complete: FAT12
expect: ^fat data$
expect: ^Hello\.txt$
expect: ^/dev/hd0$
reject: No such file|Can't mount

