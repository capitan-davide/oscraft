# QNX's sshd, ssh and scp on netd, over the loopback.
name: netd-ssh
needs: qnx
timeout: 45
run: mkdir -p -m 700 /tmp/k /var/chroot/sshd; rm -f /tmp/k/id; /compat/qnx/usr/bin/ssh-keygen -q -t ed25519 -N '' -f /tmp/k/id; echo keygen=$?
run: cp /tmp/k/id.pub /tmp/k/authorized_keys; chmod 600 /tmp/k/authorized_keys
run: /compat/qnx/usr/sbin/sshd -p 2222 -o PermitRootLogin=yes -o StrictModes=no -o "AuthorizedKeysFile /tmp/k/authorized_keys" -o LogLevel=INFO -E /tmp/k/sshd.log; echo sshd=$?
run: /bin/sh -c '/bin/sleep 1'; /compat/qnx/usr/bin/ssh -o ConnectTimeout=30 -p 2222 -i /tmp/k/id -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@127.0.0.1 'echo ssh-says-hello'; echo ssh=$?
run: echo via-stdin | /compat/qnx/usr/bin/ssh -p 2222 -i /tmp/k/id -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@127.0.0.1 /compat/qnx/bin/cat; echo cat=$?
run: echo payload > /tmp/k/in; /compat/qnx/usr/bin/scp -P 2222 -i /tmp/k/id -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /tmp/k/in root@127.0.0.1:/tmp/k/out; echo scp=$?; cat /tmp/k/out
run: tail -24 /tmp/k/sshd.log
run: slay -f sshd; sleep 1
expect: ^keygen=0
expect: ^sshd=0
expect: ^ssh-says-hello
expect: ^ssh=0
expect: ^via-stdin
expect: ^cat=0
expect: ^scp=0
expect: ^payload

# netd's modules: FreeBSD's kldload(2) through /dev/netd, a pfil(9) filter
# (user/netd/mods/pfil_test.c) that drops ICMP echo requests, and unloaded
# again, which io-sock can't do for its modules (modload_module_unload,
# read with REA).
name: netd-modules
timeout: 30
run: /bin/sleep 2; /sbin/ping -c 1 127.0.0.1 >/dev/null; echo before=$?
run: /sbin/kldload /boot/modules/pfil_test.ko; echo load=$?; /sbin/kldstat | /usr/bin/grep -c pfil_test
run: /sbin/ping -c 1 -t 2 127.0.0.1 >/dev/null; echo during=$?; echo dropped=$(/sbin/sysctl -n net.pfil_test.dropped)
run: /sbin/kldunload pfil_test; echo unload=$?; /sbin/kldstat | /usr/bin/grep -c pfil_test
run: /sbin/ping -c 1 127.0.0.1 >/dev/null; echo after=$?
run: /sbin/kldload /boot/modules/pfil_test.ko; echo again=$?; /sbin/kldunload pfil_test; echo again-unload=$?
expect: ^before=0$
expect: ^load=0$
expect: ^during=2$
expect: ^dropped=1$
expect: ^1$
expect: ^unload=0$
expect: ^0$
expect: ^after=0$
expect: ^again=0$
expect: ^again-unload=0$
reject: panic|not implemented

# FreeBSD's ipfw as a netd module, driven by ipfw(8) through socket options:
# its default rule denies, rules allow and deny, and it unloads again.
name: netd-ipfw
timeout: 40
run: /bin/sleep 2; /sbin/kldload /boot/modules/ipfw.ko; echo load=$?
run: /sbin/ping -c 1 -t 2 127.0.0.1 >/dev/null; echo default=$?
run: /sbin/ipfw add 1000 allow ip from any to any; /sbin/ping -c 1 127.0.0.1 >/dev/null; echo allowed=$?
run: /sbin/ipfw add 500 deny icmp from any to any icmptypes 8; /sbin/ping -c 1 -t 2 127.0.0.1 >/dev/null; echo denied=$?
run: /sbin/ipfw show 500; /sbin/ipfw -q flush; /sbin/kldunload ipfw; echo unload=$?
run: /sbin/ping -c 1 127.0.0.1 >/dev/null; echo after=$?; /sbin/kldstat | /usr/bin/grep -c ipfw
expect: ^load=0$
expect: ^default=2$
expect: ^allowed=0$
expect: ^denied=2$
expect: ^00500 +[1-9]
expect: ^unload=0$
expect: ^after=0$
reject: panic|not implemented

# pcid on QEMU's virt, started by the boot script: the device tree's generic
# ECAM host bridge (FreeBSD's pci_host_generic_fdt.c: no board module), and
# on the bus the virtio network device and QEMU's xhci (tools/qemu/run.sh),
# in FreeBSD's pciconf.
name: pcid-virt
timeout: 30
run: /usr/sbin/pciconf -l; echo pciconf=$?
expect: class=0x060000 .*vendor=0x1b36 device=0x0008
expect: class=0x020000 .*vendor=0x1af4 device=0x1041
expect: class=0x0c0330 .*vendor=0x1b36 device=0x000d
expect: ^pciconf=0$
reject: panic|not implemented

# The network on QEMU's virt: vtnet0, FreeBSD's virtio network driver in
# netd as modules (bsdkern's PCI client bus over pcid, virtio, its PCI
# transport, if_vtnet), loaded and configured by the boot script for QEMU's
# user-mode network. The gateway (10.0.2.2, QEMU itself) answers pings, also
# fragmented ones, and TCP reaches the host through it (tests/native/vtnet.c).
name: netd-vtnet
timeout: 40
run: /sbin/kldstat | /usr/bin/grep -c -E " (pci|virtio|virtio_pci|if_vtnet)\.ko$"
run: /sbin/ifconfig vtnet0 | /usr/bin/grep -E "flags=|ether|inet "
run: /sbin/route -n get 192.0.2.1 | /usr/bin/grep -E "gateway|interface"
run: /sbin/ping -c 3 -t 10 10.0.2.2 > /dev/null; echo ping=$?
run: /sbin/ping -c 2 -t 10 -s 4000 10.0.2.2 > /dev/null; echo big=$?
run: /proc/boot/vtnet-test; echo rc=$?
expect: ^4$
expect: ^vtnet0: flags=.*<UP,BROADCAST,RUNNING,
expect: ^\s+ether 52:54:00:12:34:56$
expect: ^\s+inet 10\.0\.2\.15 netmask 0xffffff00 broadcast 10\.0\.2\.255$
expect: ^\s+gateway: 10\.0\.2\.2$
expect: ^\s+interface: vtnet0$
expect: ^ping=0$
expect: ^big=0$
expect: ^vtnet: connect to the host's port 1: -1 errno 61 
expect: ^vtnet: passed$
expect: ^rc=0$
reject: panic|not implemented|FAILED
