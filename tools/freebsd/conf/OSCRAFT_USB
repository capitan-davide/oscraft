#
# OSCRAFT_USB: FreeBSD's USB core and host controller drivers for OsCraft's
# usbd, a user process. Not a kernel: config(8) picks the sources and writes
# the opt_*.h headers, from which libbsdusb.a is built; bsdkern supplies what
# the rest of the kernel would. The controllers are found by usbd: on PCI
# through pcid (bsdkern's PCI client bus: "device pci" here only selects
# the PCI drivers, not the bus), or from its options: no FDT.
#

cpu		ARM64
ident		OSCRAFT_USB
makeoptions	CONF_CFLAGS="-DOSCRAFT_BSDKERN -DMUTEX_NOINLINE -DRWLOCK_NOINLINE -DSX_NOINLINE -DBSDKERN_PCI_CLIENT"
makeoptions	WITHOUT_MODULES=1
makeoptions	DEBUG=-g

options 	SMP
options 	MAXCPU=8
options 	MAXMEMDOM=1

device		usb
device		dwcotg
device		xhci
device		pci
options 	USB_DEBUG
